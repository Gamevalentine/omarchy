#!/bin/bash

# omarchy:summary=Update LUNOR OS and system packages
# omarchy:alias=omarchy up

cat <<'EOF'
LUNOR OS updates are intentionally disabled in this development build.

The old upstream update service, package channels, mirrors, and repositories
have been disconnected. A dedicated LUNOR OS update service will be added
before public release.

For development machines only, Arch Linux packages can still be maintained
manually with pacman when required.
EOF

exit 2
