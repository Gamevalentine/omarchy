#!/bin/bash

# omarchy:summary=Update LUNOR OS and system packages
# omarchy:alias=omarchy up

cat <<'EOF'
LUNOR OS updates are intentionally disabled in this development build.

The old upstream Omarchy update service, package channels, mirrors, and
repositories have been disconnected so an upstream update cannot overwrite
LUNOR OS branding or replace this development tree.

A dedicated LUNOR OS update service will be added before public release.
EOF

exit 2
