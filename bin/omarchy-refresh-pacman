#!/bin/bash -p

# omarchy:summary=Reset pacman to the LUNOR development default using Arch Linux repositories only
# omarchy:requires-sudo=true

if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

set -euo pipefail

echo "Resetting pacman to Arch Linux repositories only"
sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
sudo cp -f "$OMARCHY_PATH/default/pacman/pacman-stable.conf" /etc/pacman.conf
sudo cp -f "$OMARCHY_PATH/default/pacman/mirrorlist-stable" /etc/pacman.d/mirrorlist

echo "Former upstream distro mirrors and package repositories are disabled."
sudo pacman -Syy --noconfirm
