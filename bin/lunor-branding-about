#!/bin/bash

# omarchy:summary=Edit, set, or reset About branding
# omarchy:group=branding
# omarchy:name=about
# omarchy:args=<image|text|reset>
# omarchy:examples=lunor branding about image | lunor branding about text | lunor branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(lunor file select --title "Pick PNG or SVG for About" --extensions "png svg")
  if lunor transcode ascii "$image" ~/.config/lunor/branding/about.txt --width 54 --height 26; then
    lunor launch about >/dev/null 2>&1
  fi
  ;;
text)
  lunor launch editor ~/.config/lunor/branding/about.txt >/dev/null 2>&1 && lunor launch about >/dev/null 2>&1
  ;;
reset)
  cp "$OMARCHY_PATH/icon.txt" ~/.config/lunor/branding/about.txt && lunor launch about >/dev/null 2>&1
  ;;
*)
  echo "Usage: lunor branding about <image|text|reset>" >&2
  exit 1
  ;;
esac
