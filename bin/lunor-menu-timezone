#!/bin/bash

# omarchy:summary=Select and set the system timezone
# omarchy:group=menu
# omarchy:name=timezone

set -e

timezone=$(timedatectl list-timezones | lunor menu select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
lunor shell -q omarchy.clock refresh
lunor notification send "Timezone is now set to $timezone"
