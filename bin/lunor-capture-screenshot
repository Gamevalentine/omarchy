#!/bin/bash

# omarchy:summary=Take a screenshot
# omarchy:group=capture
# omarchy:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# omarchy:examples=lunor screenshot | lunor capture screenshot region
# omarchy:aliases=lunor screenshot

screenshot_dir="${LUNOR_SCREENSHOT_DIR:-${OMARCHY_SCREENSHOT_DIR:-}}"
if [[ -n $screenshot_dir && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$screenshot_dir"
fi

omasnap_args=()
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
