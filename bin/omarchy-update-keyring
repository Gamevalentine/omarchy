#!/bin/bash

# omarchy:summary=Ensure the Arch Linux signing keyring is installed and current
# omarchy:requires-sudo=true

set -euo pipefail

echo -e "\e[32m\nUpdate Arch Linux signing keys\e[0m"
sudo pacman -Sy --noconfirm archlinux-keyring >/dev/null 2> >(grep -vE '^warning: archlinux-keyring-[^ ]+ is up to date -- reinstalling$' >&2)

echo "Arch Linux signing keys are current"
