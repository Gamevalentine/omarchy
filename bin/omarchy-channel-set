#!/bin/bash

# omarchy:summary=Set the LUNOR OS package channel.
# omarchy:args=<stable|rc|edge|dev>

cat >&2 <<'EOF'
LUNOR OS package-channel switching is disabled in this development build.

The upstream Omarchy channels are intentionally not used. A LUNOR-owned
package/update channel will be added before public release.
EOF

exit 2
