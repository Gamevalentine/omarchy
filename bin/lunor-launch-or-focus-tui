#!/bin/bash

# omarchy:summary=Launch a TUI or focus an existing terminal window for it
# omarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.lunor.$(basename "$1")"
fi

printf -v LAUNCH_COMMAND '%q ' lunor launch tui "$@"

exec lunor launch or focus "$APP_ID" "$LAUNCH_COMMAND"
