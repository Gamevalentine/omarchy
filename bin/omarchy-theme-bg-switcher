#!/bin/bash

# omarchy:summary=Open the LUNOR OS background switcher
# omarchy:group=theme
# omarchy:name=bg-switcher
# omarchy:aliases=omarchy background

theme_name=$(cat "$HOME/.local/state/lunor/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$HOME/.local/state/lunor/current/background" 2>/dev/null)

omarchy-menu-images \
  --selected "$current_background" \
  "$HOME/.local/state/lunor/current/theme/backgrounds" \
  "$HOME/.config/lunor/backgrounds/$theme_name"
