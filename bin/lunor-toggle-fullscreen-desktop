#!/bin/bash

# omarchy:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# omarchy:args=[toggle|on|off]
# omarchy:examples=lunor toggle fullscreen desktop | lunor toggle fullscreen desktop off | lunor toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if lunor toggle enabled bar-off && lunor hyprland toggle enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: lunor toggle fullscreen desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

lunor toggle bar "$ACTION"
lunor hyprland toggle window-no-gaps "$ACTION"
