#!/bin/bash

# omarchy:summary=Cycle to the next media source and transfer playback when the current source is playing
# omarchy:args=[next|previous]
# omarchy:examples=lunor audio source switch | lunor audio source switch previous

direction="${1:-next}"

case "$direction" in
  next)
    lunor shell media sourceSwitch
    ;;
  previous)
    lunor shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: lunor audio source switch [next|previous]" >&2
    exit 1
    ;;
esac
