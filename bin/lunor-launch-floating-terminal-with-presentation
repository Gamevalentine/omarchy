#!/bin/bash

# omarchy:summary=Launch a floating terminal with the LUNOR OS presentation wrapper
# omarchy:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source lunor-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="lunor show logo; $cmd; code=\$?; if (( code != 130 )); then lunor show done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.lunor.terminal --title=LUNOR OS -e bash -c "$presentation_script"
