#!/bin/bash
# LUNOR VM-only diagnostic harness. Never ship as product acceptance.
set -uo pipefail
out=/tmp/omarchy-acceptance
mkdir -p "$out"
export PATH="/usr/share/omarchy/bin:$PATH"
log(){ echo "LUNOR DIAG: $*"; }
root_install(){ printf '%s\n' "$OMARCHY_ACCEPTANCE_SUDO_PASSWORD" | sudo -S -- install -m "$1" "$2" "$3" 2>/dev/null; }
ov=/usr/share/omarchy/shell/Ui/OverlayWindow.qml
la=/usr/share/omarchy/bin/omarchy-launch-shell
cp "$ov" "$out/diag-original-overlay.qml"
cp "$la" "$out/diag-original-launcher.sh"
{
  date -Is
  pacman -Q quickshell qt6-base qt6-declarative hyprland
  hyprctl -j monitors
  pgrep -af 'quickshell|omarchy-launch-shell' || true
} >"$out/diag-environment.log" 2>&1
ready(){
  for n in $(seq 1 70); do
    omarchy-shell shell ping >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}
restart(){
  log "Restart for $1"
  timeout --signal=TERM --kill-after=3s 110s omarchy-restart-shell \
    >"$out/diag-$1-restart.log" 2>&1 || log "Shell restart trouble $1"
  ready || log "Shell ping failed $1"
  sleep 3
}
sample(){
  label="$1"; surface="$2"
  omarchy-shell shell hide omarchy.menu >/dev/null 2>&1 || true
  omarchy-shell shell hide omarchy.clipboard >/dev/null 2>&1 || true
  sleep 1
  if [[ "$surface" == menu ]]; then
    omarchy-shell shell summon omarchy.menu '{"menu":"root"}' >/dev/null 2>&1 || true
  else
    printf '%s' 'LUNOR-DIAG-CLIPBOARD' | wl-copy
    sleep 2
    omarchy-shell shell summon omarchy.clipboard >/dev/null 2>&1 || true
    sleep 1
    wtype 'LUNOR-DIAG-CLIPBOARD' >/dev/null 2>&1 || true
  fi
  sleep 3
  hyprctl -j layers >"$out/diag-$label-layers.json" 2>&1 || true
  timeout 12 grim "$out/diag-$label.png" >/dev/null 2>&1 || true
  if [[ -s "$out/diag-$label.png" ]]; then
    tesseract "$out/diag-$label.png" stdout --psm 11 >"$out/diag-$label-ocr.txt" 2>/dev/null || true
  fi
  journalctl --user -t omarchy-shell --no-pager -n 250 >"$out/diag-$label-shell.log" 2>&1 || true
  {
    echo "$label"
    wc -c "$out/diag-$label.png" 2>/dev/null || true
    grep -Ei 'Apps|LUNOR-DIAG-CLIPBOARD' "$out/diag-$label-ocr.txt" 2>/dev/null || true
    pgrep -af quickshell || true
  } >>"$out/diag-summary.log"
  log "Captured $label"
}
ready || log "Initial shell ping unavailable"
log "A: unmodified installed ISO 19"
sample a-menu menu
sample a-clipboard clipboard
log "B: show QML content independently of initial 1x1 size"
python3 - "$ov" "$out/diag-visible-overlay.qml" <<'PY'
from pathlib import Path
import sys
s=Path(sys.argv[1]).read_text()
old="value: window.shown && window.width > 1 && window.height > 1"
if s.count(old)!=1: raise SystemExit("Unexpected overlay source")
Path(sys.argv[2]).write_text(s.replace(old,"value: window.shown",1))
PY
if [[ -s "$out/diag-visible-overlay.qml" ]] && root_install 644 "$out/diag-visible-overlay.qml" "$ov"; then
  restart b-visible
  sample b-menu menu
  sample b-clipboard clipboard
else log "B skipped"; fi
log "C: original overlay, Qt software rendering"
root_install 644 "$out/diag-original-overlay.qml" "$ov" || true
python3 - "$la" "$out/diag-software-launcher.sh" <<'PY'
from pathlib import Path
import sys
s=Path(sys.argv[1]).read_text()
old='if [[ $(systemd-detect-virt 2>/dev/null || true) == "oracle" ]]; then'
if s.count(old)!=1: raise SystemExit("Unexpected launcher source")
Path(sys.argv[2]).write_text(s.replace(old,'if true; then # VM DIAGNOSTIC software renderer',1))
PY
if [[ -s "$out/diag-software-launcher.sh" ]] && root_install 755 "$out/diag-software-launcher.sh" "$la"; then
  restart c-software
  sample c-menu menu
  sample c-clipboard clipboard
else log "C skipped"; fi
log "D: both changes"
if [[ -s "$out/diag-visible-overlay.qml" ]] && root_install 644 "$out/diag-visible-overlay.qml" "$ov"; then
  restart d-combined
  sample d-menu menu
  sample d-clipboard clipboard
fi
log "Only diagnostic cases completed; this does NOT mark acceptance PASS"
cat "$out/diag-summary.log" 2>/dev/null || true
exit 0
