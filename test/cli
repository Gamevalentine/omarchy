#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
CLI="$ROOT/bin/omarchy"
LUNOR="$ROOT/bin/lunor"
TMPDIRS=()

export PATH="$ROOT/bin:$PATH"

# Assigns a fresh temporary directory to the named variable and registers it for
# removal on exit, so every scratch directory this suite makes is cleaned up.
make_tmpdir() {
  local -n dir_ref="$1"

  dir_ref=$(mktemp -d)
  TMPDIRS+=("$dir_ref")
}

pass() {
  printf 'ok - %s\n' "$1"
}

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

assert_output_contains() {
  local description="$1"
  local output="$2"
  local expected="$3"

  if [[ $output != *"$expected"* ]]; then
    printf 'Expected output to contain: %s\n' "$expected" >&2
    printf 'Actual output:\n%s\n' "$output" >&2
    fail "$description"
  fi

  pass "$description"
}

cleanup() {
  local dir

  for dir in ${TMPDIRS[@]+"${TMPDIRS[@]}"}; do
    [[ -d $dir ]] && rm -rf "$dir"
  done

  return 0
}
trap cleanup EXIT

output=$("$CLI" --help)
assert_output_contains "main help renders" "$output" "LUNOR OS command center"
assert_output_contains "main help includes hardware group" "$output" "hw"
assert_output_contains "main help includes package group" "$output" "pkg"
if grep -Eq '^  [a-z0-9-]+[[:space:]].*\([0-9]+\)$' <<<"$output"; then
  fail "main help does not show group counts"
fi
pass "main help does not show group counts"

output=$("$CLI" commands)
assert_output_contains "commands lists documented commands" "$output" "omarchy theme set <theme-name>"

"$CLI" commands --json | jq -e '.ok == true and (.commands | length >= 200)' >/dev/null
pass "commands --json is valid JSON with full bin coverage"

"$CLI" commands --json | jq -e 'all(.commands[]; .summary != "undocumented")' >/dev/null
pass "all included commands have summaries"

"$CLI" commands --json | jq -e 'all(.commands[]; has("binary") and has("filename_route") and has("routes") and (has("legacy") | not) and (has("usage") | not) and (has("visibility") | not) and (has("mutates") | not) and (has("interactive") | not))' >/dev/null
pass "JSON uses binary/routes and omits legacy/usage/extra metadata"

"$CLI" commands --check >/dev/null
pass "commands --check passes"

"$LUNOR" commands --check >/dev/null
pass "lunor commands --check passes during mixed-prefix migration"

"$LUNOR" commands --all --json | jq -e '.commands[] | select(.binary == "lunor-branding-about" and .route == "lunor branding about" and .filename_route == "lunor branding about")' >/dev/null
pass "lunor prefers migrated lunor-* branding binaries"

"$LUNOR" commands --json | jq -e '.commands[] | select(.binary == "lunor-install-ai-chatgpt" and .route == "lunor install ai chatgpt" and .filename_route == "lunor install ai chatgpt")' >/dev/null
pass "lunor prefers migrated AI installer binaries"

output=$("$LUNOR" branding about --help)
assert_output_contains "lunor branding help renders canonical route" "$output" "lunor branding about <image|text|reset>"

"$LUNOR" commands --all --json | jq -e '
  [.commands[]
   | select(.binary == "lunor-launch-about"
         or .binary == "lunor-launch-screensaver"
         or .binary == "lunor-launch-or-focus-tui"
         or .binary == "lunor-launch-tui"
         or .binary == "lunor-launch-or-focus"
         or .binary == "lunor-screensaver")]
  | length == 6
' >/dev/null
pass "lunor prefers migrated About/screensaver launch chain"

output=$("$LUNOR" launch about --help)
assert_output_contains "lunor About launcher help is canonical" "$output" "lunor launch about"

output=$("$CLI" launch about --help)
assert_output_contains "legacy About launcher remains available" "$output" "omarchy launch about"

"$LUNOR" commands --all --json | jq -e '
  [.commands[]
   | select(.binary == "lunor-toggle-enabled"
         or .binary == "lunor-hyprland-monitor-focused"
         or .binary == "lunor-notification-send")]
  | length == 3
' >/dev/null
pass "lunor prefers migrated screensaver support commands"

output=$("$LUNOR" toggle enabled --help)
assert_output_contains "lunor toggle enabled help is canonical" "$output" "lunor toggle enabled <flag-name>"

output=$("$LUNOR" hyprland monitor focused --help)
assert_output_contains "lunor focused monitor help is canonical" "$output" "lunor hyprland monitor focused"

output=$("$LUNOR" notification send --help)
assert_output_contains "lunor notification help is canonical" "$output" "lunor notification send"

toggle_home=$(mktemp -d)
TMPDIRS+=("$toggle_home")
mkdir -p "$toggle_home/.local/state/lunor/toggles"
touch "$toggle_home/.local/state/lunor/toggles/test-flag"
HOME="$toggle_home" "$LUNOR" toggle enabled test-flag
pass "lunor toggle enabled dispatches canonical binary"
if HOME="$toggle_home" "$LUNOR" toggle enabled missing-flag; then
  fail "lunor toggle enabled returns false for a missing flag"
fi
pass "lunor toggle enabled returns false for a missing flag"

"$LUNOR" commands --all --json | jq -e '
  [.commands[]
   | select(.binary == "lunor-toggle"
         or .binary == "lunor-toggle-screensaver")]
  | length == 2
' >/dev/null
pass "lunor prefers the migrated core and screensaver toggle commands"

output=$("$LUNOR" toggle --help)
assert_output_contains "lunor core toggle help is canonical" "$output" "lunor toggle <flag-name> [toggle|on|off]"

output=$("$LUNOR" toggle screensaver --help)
assert_output_contains "lunor screensaver toggle help is canonical" "$output" "lunor toggle screensaver"

toggle_core_home=$(mktemp -d)
TMPDIRS+=("$toggle_core_home")
HOME="$toggle_core_home" "$LUNOR" toggle demo on
[[ -f "$toggle_core_home/.local/state/lunor/toggles/demo" ]] || fail "lunor toggle on creates the flag"
HOME="$toggle_core_home" "$LUNOR" toggle demo off
[[ ! -f "$toggle_core_home/.local/state/lunor/toggles/demo" ]] || fail "lunor toggle off removes the flag"
HOME="$toggle_core_home" "$LUNOR" toggle demo
[[ -f "$toggle_core_home/.local/state/lunor/toggles/demo" ]] || fail "lunor toggle flips an absent flag on"
HOME="$toggle_core_home" "$LUNOR" toggle demo
[[ ! -f "$toggle_core_home/.local/state/lunor/toggles/demo" ]] || fail "lunor toggle flips a present flag off"
pass "lunor core toggle behavior works"

"$LUNOR" commands --all --json | jq -e '
  .commands[]
  | select(.binary == "lunor-toggle-idle"
        and .route == "lunor toggle idle"
        and .filename_route == "lunor toggle idle")
' >/dev/null
pass "lunor prefers the migrated idle toggle command"

output=$("$LUNOR" toggle idle --help)
assert_output_contains "lunor idle toggle help is canonical" "$output" "lunor toggle idle [toggle|stay-awake|allow-idle|status]"

idle_home=$(mktemp -d)
TMPDIRS+=("$idle_home")
status=$(HOME="$idle_home" "$LUNOR" toggle idle --status)
[[ $status == '{"enabled":false,"class":"disabled","tooltip":"Stay Awake"}' ]] || fail "lunor idle status starts disabled"

output=$(HOME="$idle_home" "$LUNOR" toggle idle stay-awake)
[[ $output == "disabled" ]] || fail "lunor idle stay-awake disables idle"
[[ -f "$idle_home/.local/state/lunor/indicators/stay-awake" ]] || fail "lunor idle stay-awake writes state"

status=$(HOME="$idle_home" "$LUNOR" toggle idle status)
[[ $status == '{"enabled":true,"class":"enabled","tooltip":"Allow Idle Lock & Screensaver"}' ]] || fail "lunor idle status reports stay-awake"

output=$(HOME="$idle_home" "$LUNOR" toggle idle allow-idle)
[[ $output == "enabled" ]] || fail "lunor idle allow-idle enables idle"
[[ ! -f "$idle_home/.local/state/lunor/indicators/stay-awake" ]] || fail "lunor idle allow-idle removes state"
pass "lunor idle toggle behavior works"

"$LUNOR" commands --all --json | jq -e '
  [.commands[]
   | select(.binary == "lunor-toggle-suspend"
         or .binary == "lunor-toggle-theme-sync")]
  | length == 2
' >/dev/null
pass "lunor prefers the simple migrated toggle batch"

output=$("$LUNOR" toggle suspend --help)
assert_output_contains "lunor suspend toggle help is canonical" "$output" "lunor toggle suspend"

output=$("$LUNOR" toggle theme sync --help)
assert_output_contains "lunor theme sync toggle help is canonical" "$output" "lunor toggle theme sync"

make_tmpdir SIMPLE_TOGGLE_BIN
cat >"$SIMPLE_TOGGLE_BIN/lunor" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$LUNOR_TEST_LOG"
if [[ $1 == "toggle" && $2 == "enabled" ]]; then
  [[ ${LUNOR_TEST_ENABLED:-0} == "1" ]]
  exit
fi
exit 0
EOF
chmod +x "$SIMPLE_TOGGLE_BIN/lunor"

suspend_log="$SIMPLE_TOGGLE_BIN/suspend.log"
LUNOR_TEST_LOG="$suspend_log" LUNOR_TEST_ENABLED=1 PATH="$SIMPLE_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-suspend"
grep -Fxq 'toggle suspend-off' "$suspend_log" || fail "lunor suspend toggle flips its flag"
grep -Fxq 'toggle enabled suspend-off' "$suspend_log" || fail "lunor suspend toggle checks its flag"
grep -Fq 'notification send' "$suspend_log" || fail "lunor suspend toggle sends a LUNOR notification"
grep -Fq 'Suspend removed from system menu' "$suspend_log" || fail "lunor suspend toggle reports disabled state"
pass "lunor suspend toggle uses only migrated dependencies"

theme_sync_log="$SIMPLE_TOGGLE_BIN/theme-sync.log"
LUNOR_TEST_LOG="$theme_sync_log" LUNOR_TEST_ENABLED=0 PATH="$SIMPLE_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-theme-sync"
grep -Fxq 'toggle herdr-theme-sync' "$theme_sync_log" || fail "lunor theme sync toggle flips its flag"
grep -Fxq 'toggle enabled herdr-theme-sync' "$theme_sync_log" || fail "lunor theme sync toggle checks its flag"
grep -Fq 'notification send' "$theme_sync_log" || fail "lunor theme sync toggle sends a LUNOR notification"
grep -Fq 'Herdr theme sync disabled' "$theme_sync_log" || fail "lunor theme sync toggle reports disabled state"
pass "lunor theme sync toggle uses only migrated dependencies"

"$LUNOR" commands --all --json | jq -e '
  [.commands[]
   | select(.binary == "lunor-hyprland-toggle"
         or .binary == "lunor-hyprland-toggle-enabled")]
  | length == 2
' >/dev/null
pass "lunor prefers migrated Hyprland toggle primitives"

output=$("$LUNOR" hyprland toggle --help)
assert_output_contains "lunor Hyprland toggle help is canonical" "$output" "lunor hyprland toggle <flag-name> [on|off|toggle]"

output=$("$LUNOR" hyprland toggle enabled --help)
assert_output_contains "lunor Hyprland toggle enabled help is canonical" "$output" "lunor hyprland toggle enabled <flag-name>"

make_tmpdir HYPR_TOGGLE_TMP
mkdir -p "$HYPR_TOGGLE_TMP/root/default/hypr/toggles" "$HYPR_TOGGLE_TMP/bin"
printf 'return "demo"\n' >"$HYPR_TOGGLE_TMP/root/default/hypr/toggles/demo.lua"
cat >"$HYPR_TOGGLE_TMP/bin/hyprctl" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$HYPRCTL_TEST_LOG"
exit 0
EOF
chmod +x "$HYPR_TOGGLE_TMP/bin/hyprctl"

hypr_home="$HYPR_TOGGLE_TMP/home"
hypr_log="$HYPR_TOGGLE_TMP/hyprctl.log"

output=$(HOME="$hypr_home" LUNOR_PATH="$HYPR_TOGGLE_TMP/root" HYPRCTL_TEST_LOG="$hypr_log" PATH="$HYPR_TOGGLE_TMP/bin:$PATH" "$LUNOR" hyprland toggle demo)
[[ $output == "on" ]] || fail "lunor Hyprland toggle enables an absent flag"
cmp "$HYPR_TOGGLE_TMP/root/default/hypr/toggles/demo.lua" "$hypr_home/.local/state/lunor/toggles/hypr/demo.lua" >/dev/null ||
  fail "lunor Hyprland toggle copies the LUNOR flag source"
HOME="$hypr_home" "$LUNOR" hyprland toggle enabled demo ||
  fail "lunor Hyprland toggle enabled sees active flag"

output=$(HOME="$hypr_home" LUNOR_PATH="$HYPR_TOGGLE_TMP/root" HYPRCTL_TEST_LOG="$hypr_log" PATH="$HYPR_TOGGLE_TMP/bin:$PATH" "$LUNOR" hyprland toggle demo)
[[ $output == "off" ]] || fail "lunor Hyprland toggle disables a present flag"
if HOME="$hypr_home" "$LUNOR" hyprland toggle enabled demo; then
  fail "lunor Hyprland toggle enabled reports removed flag as active"
fi

[[ $(grep -c '^reload$' "$hypr_log") == "2" ]] || fail "lunor Hyprland toggle reloads Hyprland after each change"
pass "lunor Hyprland toggle primitives work"

"$LUNOR" commands --all --json | jq -e '
  .commands[]
  | select(.binary == "lunor-toggle-animations"
        and .route == "lunor toggle animations"
        and .filename_route == "lunor toggle animations")
' >/dev/null
pass "lunor prefers the migrated animations toggle command"

output=$("$LUNOR" toggle animations --help)
assert_output_contains "lunor animations toggle help is canonical" "$output" "lunor toggle animations [toggle|on|off]"

make_tmpdir ANIMATIONS_TOGGLE_BIN
cat >"$ANIMATIONS_TOGGLE_BIN/lunor" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$LUNOR_TEST_LOG"
if [[ $1 == "hyprland" && $2 == "toggle" && $3 == "enabled" ]]; then
  [[ ${LUNOR_TEST_ANIMATIONS_DISABLED:-0} == "1" ]]
  exit
fi
exit 0
EOF
chmod +x "$ANIMATIONS_TOGGLE_BIN/lunor"

animations_log="$ANIMATIONS_TOGGLE_BIN/toggle.log"
LUNOR_TEST_LOG="$animations_log" LUNOR_TEST_ANIMATIONS_DISABLED=1 PATH="$ANIMATIONS_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-animations" toggle
grep -Fxq 'hyprland toggle no-animations toggle' "$animations_log" || fail "lunor animations toggle maps toggle action to Hyprland"
grep -Fxq 'hyprland toggle enabled no-animations' "$animations_log" || fail "lunor animations toggle checks migrated Hyprland state"
grep -Fq 'notification send' "$animations_log" || fail "lunor animations toggle sends a LUNOR notification"
grep -Fq 'Animations disabled' "$animations_log" || fail "lunor animations toggle reports disabled state"

: >"$animations_log"
LUNOR_TEST_LOG="$animations_log" LUNOR_TEST_ANIMATIONS_DISABLED=0 PATH="$ANIMATIONS_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-animations" on
grep -Fxq 'hyprland toggle no-animations off' "$animations_log" || fail "lunor animations on removes no-animations flag"
grep -Fq 'Animations enabled' "$animations_log" || fail "lunor animations on reports enabled state"

: >"$animations_log"
LUNOR_TEST_LOG="$animations_log" LUNOR_TEST_ANIMATIONS_DISABLED=1 PATH="$ANIMATIONS_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-animations" off
grep -Fxq 'hyprland toggle no-animations on' "$animations_log" || fail "lunor animations off adds no-animations flag"
grep -Fq 'Animations disabled' "$animations_log" || fail "lunor animations off reports disabled state"
pass "lunor animations toggle uses migrated dependencies"

"$LUNOR" commands --all --json | jq -e '
  .commands[]
  | select(.binary == "lunor-toggle-fullscreen-desktop"
        and .route == "lunor toggle fullscreen desktop"
        and .filename_route == "lunor toggle fullscreen desktop")
' >/dev/null
pass "lunor prefers the migrated fullscreen desktop toggle"

output=$("$LUNOR" toggle fullscreen desktop --help)
assert_output_contains "lunor fullscreen desktop help is canonical" "$output" "lunor toggle fullscreen desktop [toggle|on|off]"

make_tmpdir FULLSCREEN_TOGGLE_BIN
cat >"$FULLSCREEN_TOGGLE_BIN/lunor" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$LUNOR_TEST_LOG"
case "$*" in
  "toggle enabled bar-off")
    [[ ${LUNOR_TEST_BAR_OFF:-0} == "1" ]]
    ;;
  "hyprland toggle enabled window-no-gaps")
    [[ ${LUNOR_TEST_NO_GAPS:-0} == "1" ]]
    ;;
  *)
    exit 0
    ;;
esac
EOF
chmod +x "$FULLSCREEN_TOGGLE_BIN/lunor"

fullscreen_log="$FULLSCREEN_TOGGLE_BIN/toggle.log"
LUNOR_TEST_LOG="$fullscreen_log" LUNOR_TEST_BAR_OFF=1 LUNOR_TEST_NO_GAPS=1 PATH="$FULLSCREEN_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-fullscreen-desktop"
grep -Fxq 'toggle bar off' "$fullscreen_log" || fail "lunor fullscreen toggle exits full screen when both halves are active"
grep -Fxq 'hyprland toggle window-no-gaps off' "$fullscreen_log" || fail "lunor fullscreen toggle restores gaps when exiting full screen"

: >"$fullscreen_log"
LUNOR_TEST_LOG="$fullscreen_log" LUNOR_TEST_BAR_OFF=1 LUNOR_TEST_NO_GAPS=0 PATH="$FULLSCREEN_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-fullscreen-desktop"
grep -Fxq 'toggle bar on' "$fullscreen_log" || fail "lunor fullscreen toggle aligns a partial state by entering full screen"
grep -Fxq 'hyprland toggle window-no-gaps on' "$fullscreen_log" || fail "lunor fullscreen toggle removes gaps when entering full screen"

: >"$fullscreen_log"
LUNOR_TEST_LOG="$fullscreen_log" PATH="$FULLSCREEN_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-fullscreen-desktop" off
grep -Fxq 'toggle bar off' "$fullscreen_log" || fail "lunor fullscreen off forwards to bar"
grep -Fxq 'hyprland toggle window-no-gaps off' "$fullscreen_log" || fail "lunor fullscreen off forwards to Hyprland"

: >"$fullscreen_log"
LUNOR_TEST_LOG="$fullscreen_log" PATH="$FULLSCREEN_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-fullscreen-desktop" on
grep -Fxq 'toggle bar on' "$fullscreen_log" || fail "lunor fullscreen on forwards to bar"
grep -Fxq 'hyprland toggle window-no-gaps on' "$fullscreen_log" || fail "lunor fullscreen on forwards to Hyprland"
pass "lunor fullscreen desktop toggle preserves coordinated behavior"

"$LUNOR" commands --all --json | jq -e '
  [.commands[]
   | select(.binary == "lunor-toggle-bar"
         or .binary == "lunor-toggle-nightlight"
         or .binary == "lunor-toggle-notification-silencing"
         or .binary == "lunor-toggle-touchpad"
         or .binary == "lunor-toggle-touchscreen")]
  | length == 5
' >/dev/null
pass "lunor prefers the migrated easy toggle batch"

output=$("$LUNOR" toggle bar --help)
assert_output_contains "lunor bar toggle help is canonical" "$output" "lunor toggle bar [toggle|on|off]"

output=$("$LUNOR" toggle nightlight --help)
assert_output_contains "lunor nightlight help is canonical" "$output" "lunor toggle nightlight [--status]"

output=$("$LUNOR" toggle notification silencing --help)
assert_output_contains "lunor notification silencing help is canonical" "$output" "lunor toggle notification silencing"

output=$("$LUNOR" toggle touchpad --help)
assert_output_contains "lunor touchpad help is canonical" "$output" "lunor toggle touchpad [on|off|toggle]"

output=$("$LUNOR" toggle touchscreen --help)
assert_output_contains "lunor touchscreen help is canonical" "$output" "lunor toggle touchscreen [on|off|toggle]"

make_tmpdir EASY_TOGGLE_BIN
cat >"$EASY_TOGGLE_BIN/lunor" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$LUNOR_TEST_LOG"
exit 0
EOF
chmod +x "$EASY_TOGGLE_BIN/lunor"

bar_log="$EASY_TOGGLE_BIN/bar.log"
LUNOR_TEST_LOG="$bar_log" PATH="$EASY_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-bar" off
grep -Fxq 'toggle bar-off off' "$bar_log" || fail "lunor bar toggle uses canonical toggle primitive"
grep -Fxq 'shell -q omarchy.bar syncHidden' "$bar_log" || fail "lunor bar toggle preserves shell target while using canonical shell route"
pass "lunor bar toggle uses canonical routes"

notify_log="$EASY_TOGGLE_BIN/notification.log"
LUNOR_TEST_LOG="$notify_log" PATH="$EASY_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-notification-silencing"
grep -Fxq 'shell notifications toggleDnd' "$notify_log" || fail "lunor notification silencing toggles DND through canonical shell route"
grep -Fxq 'shell -q omarchy.indicators refresh' "$notify_log" || fail "lunor notification silencing preserves indicator target while using canonical shell route"
pass "lunor notification silencing uses canonical routes"

touch_log="$EASY_TOGGLE_BIN/touch.log"
LUNOR_TEST_LOG="$touch_log" PATH="$EASY_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-touchpad" off
grep -Fxq 'toggle input device touchpad off' "$touch_log" || fail "lunor touchpad wrapper forwards through canonical route"
: >"$touch_log"
LUNOR_TEST_LOG="$touch_log" PATH="$EASY_TOGGLE_BIN:$PATH" "$ROOT/bin/lunor-toggle-touchscreen" on
grep -Fxq 'toggle input device touchscreen on' "$touch_log" || fail "lunor touchscreen wrapper forwards through canonical route"
pass "lunor touch device wrappers use canonical routes"

make_tmpdir NIGHTLIGHT_BIN
cat >"$NIGHTLIGHT_BIN/pgrep" <<'EOF'
#!/bin/bash
exit 0
EOF
cat >"$NIGHTLIGHT_BIN/hyprctl" <<'EOF'
#!/bin/bash
if [[ $* == "hyprsunset temperature" ]]; then
  printf 'Temperature: 6500K\n'
  exit 0
fi
exit 0
EOF
chmod +x "$NIGHTLIGHT_BIN/pgrep" "$NIGHTLIGHT_BIN/hyprctl"

night_status=$(PATH="$NIGHTLIGHT_BIN:$PATH" "$ROOT/bin/lunor-toggle-nightlight" --status)
[[ $night_status == '{"enabled":false,"temperature":6500}' ]] || fail "lunor nightlight status preserves behavior"
pass "lunor nightlight status works"

"$LUNOR" commands --all --json | jq -e '
  [.commands[]
   | select(.binary == "lunor-shell"
         or .binary == "lunor-osd"
         or .binary == "lunor-hw-touchpad"
         or .binary == "lunor-hw-touchscreen"
         or .binary == "lunor-toggle-input-device")]
  | length == 5
' >/dev/null
pass "lunor prefers migrated shared primitives"

output=$("$LUNOR" shell --help)
assert_output_contains "lunor shell help is canonical" "$output" "lunor shell [-q] <target> <method> [args...]"

output=$("$LUNOR" osd --help)
assert_output_contains "lunor OSD help is canonical" "$output" "lunor osd [-i|--icon <icon>]"

output=$("$LUNOR" toggle input device --help)
assert_output_contains "lunor input-device help is canonical" "$output" "lunor toggle input device <touchpad|touchscreen> [on|off|toggle]"

output=$("$LUNOR" hw touchpad --help)
assert_output_contains "lunor touchpad detector help is canonical" "$output" "lunor hw touchpad"

output=$("$LUNOR" hw touchscreen --help)
assert_output_contains "lunor touchscreen detector help is canonical" "$output" "lunor hw touchscreen"

if grep -Fq '$OMARCHY_PATH' "$ROOT/bin/lunor-shell"; then
  fail "lunor shell does not depend on OMARCHY_PATH"
fi
pass "lunor shell uses LUNOR_PATH as its canonical root"

make_tmpdir SHARED_PRIMITIVE_BIN
cat >"$SHARED_PRIMITIVE_BIN/lunor" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$LUNOR_TEST_LOG"
case "$*" in
  "hw touchpad") printf 'ELAN Touchpad\n' ;;
  "hw touchscreen") printf 'Goodix Touchscreen\n' ;;
esac
exit 0
EOF
cat >"$SHARED_PRIMITIVE_BIN/hyprctl" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$HYPRCTL_TEST_LOG"
exit 0
EOF
chmod +x "$SHARED_PRIMITIVE_BIN/lunor" "$SHARED_PRIMITIVE_BIN/hyprctl"

input_home="$SHARED_PRIMITIVE_BIN/home"
input_calls="$SHARED_PRIMITIVE_BIN/lunor.log"
hypr_calls="$SHARED_PRIMITIVE_BIN/hyprctl.log"

LUNOR_TEST_LOG="$input_calls" HYPRCTL_TEST_LOG="$hypr_calls" HOME="$input_home" PATH="$SHARED_PRIMITIVE_BIN:$PATH" "$ROOT/bin/lunor-toggle-input-device" touchpad off
