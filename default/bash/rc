: "${LUNOR_PATH:=${OMARCHY_PATH:-/usr/share/lunor}}"
OMARCHY_PATH=$LUNOR_PATH
export LUNOR_PATH OMARCHY_PATH

source "$LUNOR_PATH/default/bash/envs"
source "$LUNOR_PATH/default/bash/shell"
source "$LUNOR_PATH/default/bash/aliases"
source "$LUNOR_PATH/default/bash/functions"
source "$LUNOR_PATH/default/bash/init"
[[ $- == *i* ]] && bind -f "$LUNOR_PATH/default/bash/inputrc"
