# Single source of truth for LUNOR_PATH + PATH adjustments.
# OMARCHY_PATH is exported temporarily as a compatibility alias while the
# remaining internal command namespace is migrated in isolated steps.
#
# Sourced by:
#   /etc/profile.d/omarchy.sh
#   /etc/skel/.bashrc
#   /usr/share/uwsm/env.d/10-omarchy
#   the LUNOR bash rc chain

# Prefer the future LUNOR package root. Until package layout migration is
# complete, fall back to the currently packaged source tree.
lunor_packaged_root=/usr/share/lunor
if [ ! -d "$lunor_packaged_root" ] && [ -d /usr/share/omarchy ]; then
  lunor_packaged_root=/usr/share/omarchy
fi

# /etc/lunor.conf is the canonical development-link configuration.
if [ -f /etc/lunor.conf ]; then
  . /etc/lunor.conf
fi

: "${LUNOR_PATH:=$lunor_packaged_root}"
export LUNOR_PATH

# Temporary compatibility alias. Remove after all runtime consumers use
# LUNOR_PATH directly.
OMARCHY_PATH=$LUNOR_PATH
export OMARCHY_PATH

# Only prepend in dev-link mode.
if [ "$LUNOR_PATH" != "$lunor_packaged_root" ]; then
  case ":$PATH:" in
    *":${LUNOR_PATH%/}/bin:"*) ;;
    *) PATH="${LUNOR_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
lunor_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
lunor_wrapper_path=$lunor_wrapper_dir
if [ -n "${PATH:-}" ]; then
  lunor_remaining_path=$PATH
  while :; do
    lunor_path_entry=${lunor_remaining_path%%:*}
    if [ "$lunor_path_entry" != "$lunor_wrapper_dir" ]; then
      lunor_wrapper_path="$lunor_wrapper_path:$lunor_path_entry"
    fi
    case "$lunor_remaining_path" in
      *:*) lunor_remaining_path=${lunor_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$lunor_wrapper_path
unset lunor_wrapper_dir lunor_wrapper_path lunor_remaining_path lunor_path_entry lunor_packaged_root

# User-level tool paths, appended so system binaries keep precedence.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
