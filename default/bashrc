# LUNOR OS environment, needed even for non-interactive shells
if [[ -r /usr/share/lunor/default/bash/env-bootstrap ]]; then
  source /usr/share/lunor/default/bash/env-bootstrap
elif [[ -r /usr/share/omarchy/default/bash/env-bootstrap ]]; then
  # Temporary package-layout compatibility until /usr/share/lunor ships.
  source /usr/share/omarchy/default/bash/env-bootstrap
fi

# Use the canonical LUNOR source root after bootstrap.
source "$LUNOR_PATH/default/bash/rc"
